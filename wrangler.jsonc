{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "redacto",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    // The production build. Models are excluded (public/.assetsignore) and served from R2 instead.
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  // redacto.cc is the public address; www and the workers.dev URL redirect to it (cloudflare/worker.ts).
  "routes": [
    { "pattern": "redacto.cc", "custom_domain": true },
    { "pattern": "www.redacto.cc", "custom_domain": true }
  ],
  "vars": { "CANONICAL_HOST": "redacto.cc" },
  // Keep the old address alive so shared links redirect instead of breaking.
  "workers_dev": true,
  "r2_buckets": [{ "binding": "MODELS", "bucket_name": "redacto-models" }],
  "observability": { "enabled": true }
}
